# Hrz7 Human-Review & Maker-Checker Console - environment template. Copy to .env for local runs.
# The local profile is the SDK-free default; production sets REVIEW_PROFILE=gcp explicitly.

# Profile: local | gcp | platform | onprem
REVIEW_PROFILE=local

# API bind (local profile refuses a non-loopback host unless the insecure-demo opt-out is set).
REVIEW_API_HOST=127.0.0.1
# REVIEW_ALLOW_INSECURE_DEMO=1
PORT=8087

# Residency: must be inside the allowlist the Terraform plan validates against
# (asia-southeast1 / asia-southeast2). An out-of-country value refuses to boot.
# REVIEW_REGION=asia-southeast1

# Bank-owned policy document (approval floors, SoD, approver entitlement). The shipped file
# equals the reference defaults; point this at the institution's approved copy.
# REVIEW_POLICY_PATH=config/policy.json

# Local hash-chained WORM audit log. Set a file path to keep the sign-off trail across restarts;
# the external head anchor (which is what detects a truncated tail) defaults to <path>.anchor and
# SHOULD be relocated to a different volume or trust domain.
# REVIEW_AUDIT_PATH=review-audit.sqlite3
# REVIEW_AUDIT_ANCHOR_PATH=/var/lib/review-anchor/head.json

# CORS: an explicit comma-separated allowlist (never "*"). Empty outside local -> no cross-origin.
# REVIEW_CORS_ORIGINS=https://console.example.com

# CSP frame-ancestors for embedding (both the API and the Next.js UI honour this).
# Three states: unset -> 'self'; set but naming no origin -> the service REFUSES to boot (an
# empty CSP directive is a parse error browsers discard, which would silently remove the
# clickjacking control); set -> exactly those origins. Say 'none' to forbid all framing.
# Keep this line COMMENTED OUT unless you are setting a value: a bare NAME= is a
# configuration, not an omission.
# REVIEW_FRAME_ANCESTORS='self' https://host-app.example.com

# Service-to-service auth (fail-closed). Unset leaves the S2S endpoint open on loopback dev only.
# Setting this authenticates a calling SERVICE and NO end user, so it does NOT relax the loopback
# exposure guard: only an identity binding that VERIFIES the end user does that (see
# docs/runbook.md). Under the local profile the console stays on loopback whether this is set or
# not.
# REVIEW_S2S_TOKEN=change-me
# REVIEW_S2S_ALLOWED_CALLERS=vertical-a@project.iam.gserviceaccount.com
# REVIEW_S2S_AUDIENCE=https://review-console-xxxx.a.run.app

# GCP profile only:
# REVIEW_IAP_AUDIENCE=/projects/000000000000/global/backendServices/0000000000000000000
# REVIEW_IAP_ENTITLEMENTS_JSON={"approver@example.invalid":{"tenant":"example-bank","hosted_domain":"example.invalid","principals":["group:risk","group:approver"]}}
# REVIEW_QUALITY_URL=https://hrz-ai-quality-xxxx.a.run.app
